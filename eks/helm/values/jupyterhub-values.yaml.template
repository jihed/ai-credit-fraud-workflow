# JupyterHub configuration template for fraud detection demo
# This template uses environment variables that will be substituted during deployment

hub:
  # Disable persistent storage for demo
  db:
    type: sqlite-memory
  
  config:
    JupyterHub:
      authenticator_class: 'jupyterhub.auth.DummyAuthenticator'  # For demo only
    DummyAuthenticator:
      password: 'fraud-detection-demo'  # For demo only - use proper auth in production
    
    Spawner:
      default_url: '/lab'
      
  extraEnv:
    # EMR on EKS configuration
    VIRTUAL_CLUSTER_ID: '${VIRTUAL_CLUSTER_ID}'
    EMR_EXECUTION_ROLE_ARN: '${EMR_EXECUTION_ROLE_ARN}'
    
    # Ray cluster configuration
    RAY_CLUSTER_ADDRESS: '${RAY_CLUSTER_ADDRESS}'
    
    # AWS configuration
    AWS_REGION: '${AWS_REGION}'
    S3_BUCKET_NAME: '${S3_BUCKET_NAME}'

  service:
    type: LoadBalancer
    annotations:
      service.beta.kubernetes.io/aws-load-balancer-type: "nlb"
      service.beta.kubernetes.io/aws-load-balancer-scheme: "internet-facing"

singleuser:
  # Default resources for notebook pods
  cpu:
    limit: 2
    guarantee: 1
  memory:
    limit: 4G
    guarantee: 2G
  
  # Storage for user notebooks (using emptyDir for demo)
  storage:
    type: none
    homeMountPath: /home/jovyan
  
  # Service account with IRSA for S3 access
  serviceAccountName: jupyterhub-user-sa
  
  # Profile list for different workload types
  profileList:
    - display_name: "Data Processing"
      description: "EMR on EKS with Spark RAPIDS for feature engineering"
      default: true
      kubespawner_override:
        image: '${ECR_REGISTRY}/fraud-detection/spark-notebook:latest'
        cpu_limit: 4
        cpu_guarantee: 2
        mem_limit: '8G'
        mem_guarantee: '4G'
        environment:
          SPARK_DRIVER_MEMORY: '4g'
          SPARK_EXECUTOR_MEMORY: '4g'
          VIRTUAL_CLUSTER_ID: '${VIRTUAL_CLUSTER_ID}'
          EMR_EXECUTION_ROLE_ARN: '${EMR_EXECUTION_ROLE_ARN}'
          AWS_REGION: '${AWS_REGION}'
          S3_BUCKET_NAME: '${S3_BUCKET_NAME}'
          NOTEBOOK_PROFILE: 'data-processing'
        extra_labels:
          workload-type: 'spark-emr'
          
    - display_name: "ML Training"
      description: "Ray cluster connectivity for distributed XGBoost training"
      kubespawner_override:
        image: '${ECR_REGISTRY}/fraud-detection/ray-notebook:latest'
        cpu_limit: 8
        cpu_guarantee: 4
        mem_limit: '16G'
        mem_guarantee: '8G'
        environment:
          RAY_ADDRESS: '${RAY_CLUSTER_ADDRESS}'
          AWS_REGION: '${AWS_REGION}'
          S3_BUCKET_NAME: '${S3_BUCKET_NAME}'
          NOTEBOOK_PROFILE: 'ml-training'
        extra_labels:
          workload-type: 'ray-ml'
          
    - display_name: "Unified"
      description: "Both Spark and Ray capabilities for complete pipeline"
      kubespawner_override:
        image: '${ECR_REGISTRY}/fraud-detection/unified-notebook:latest'
        cpu_limit: 8
        cpu_guarantee: 4
        mem_limit: '32G'
        mem_guarantee: '16G'
        environment:
          VIRTUAL_CLUSTER_ID: '${VIRTUAL_CLUSTER_ID}'
          EMR_EXECUTION_ROLE_ARN: '${EMR_EXECUTION_ROLE_ARN}'
          RAY_ADDRESS: '${RAY_CLUSTER_ADDRESS}'
          AWS_REGION: '${AWS_REGION}'
          S3_BUCKET_NAME: '${S3_BUCKET_NAME}'
          NOTEBOOK_PROFILE: 'unified'
        extra_labels:
          workload-type: 'unified'

  # Network policy for security
  networkPolicy:
    enabled: true
    ingress:
      - from:
          - namespaceSelector:
              matchLabels:
                name: jupyterhub
    egress:
      - to: []  # Allow all egress for S3, EMR, Ray access

# Proxy configuration
proxy:
  service:
    type: LoadBalancer
    annotations:
      service.beta.kubernetes.io/aws-load-balancer-type: "nlb"
      service.beta.kubernetes.io/aws-load-balancer-scheme: "internet-facing"
  
  # HTTPS configuration (optional)
  https:
    enabled: false  # Set to true and configure certificates for production

# Scheduling configuration
scheduling:
  userScheduler:
    enabled: true
    replicas: 1
  
  podPriority:
    enabled: true
    globalDefault: false
    defaultPriority: 0
    userPlaceholderPriority: -10

# Culling configuration to save resources
cull:
  enabled: true
  timeout: 3600  # 1 hour
  every: 600     # Check every 10 minutes
  concurrency: 10
  users: false   # Don't cull named servers
  maxAge: 0      # Don't cull based on age

# Resource quotas should be managed via Kubernetes ResourceQuota objects
# See: https://kubernetes.io/docs/concepts/policy/resource-quotas/