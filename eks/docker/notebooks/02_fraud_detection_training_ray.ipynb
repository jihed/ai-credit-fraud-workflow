    "\n",
    "print(\"\\n📊 Ray Cluster Usage:\")\n",
    "print(f\"   Cluster resources: {ray.cluster_resources()}\")\n",
    "print(f\"   Active nodes: {len(ray.nodes())}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cleanup"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cleanup Ray resources\n",
    "print(\"🧹 Cleaning up Ray resources...\")\n",
    "ray.shutdown()\n",
    "print(\"✅ Ray session ended\")\n",
    "\n",
    "# Clean up local files\n",
    "import shutil\n",
    "if os.path.exists(\"/tmp/fraud_detection_model\"):\n",
    "    shutil.rmtree(\"/tmp/fraud_detection_model\")\n",
    "    print(\"✅ Local model files cleaned up\")"
   ]
  }
