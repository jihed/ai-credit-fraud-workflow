{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Fraud Detection Training with Ray on EKS\n",
    "\n",
    "This notebook demonstrates distributed XGBoost training for fraud detection using Ray on EKS.\n",
    "It loads the processed features from the feature engineering notebook and trains a model using Ray Train.\n",
    "\n",
    "## Features:\n",
    "- Ray cluster connectivity\n",
    "- Distributed XGBoost training with GPU acceleration\n",
    "- Model evaluation and metrics\n",
    "- Model saving to S3 for inference"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import ray\n",
    "import boto3\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from ray.train.xgboost import XGBoostTrainer\n",
    "from ray.train import ScalingConfig, RunConfig\n",
    "from ray.data import Dataset\n",
    "import xgboost as xgb\n",
    "from sklearn.metrics import classification_report, confusion_matrix, roc_auc_score\n",
    "import joblib\n",
    "import json\n",
    "from datetime import datetime"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Environment Setup"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Get environment variables\n",
    "RAY_ADDRESS = os.environ.get('RAY_ADDRESS', 'ray://ray-cluster-head-svc.ray-system.svc.cluster.local:10001')\n",
    "S3_BUCKET_NAME = os.environ.get('S3_BUCKET_NAME', 'REPLACE_WITH_S3_BUCKET_NAME')\n",
    "AWS_REGION = os.environ.get('AWS_DEFAULT_REGION', 'us-west-2')\n",
    "\n",
    "print(\"🔧 Environment Configuration:\")\n",
    "print(f\"   Ray Address: {RAY_ADDRESS}\")\n",
    "print(f\"   S3 Bucket: {S3_BUCKET_NAME}\")\n",
    "print(f\"   Region: {AWS_REGION}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Connect to Ray Cluster"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Connect to Ray cluster\n",
    "print(\"🚀 Connecting to Ray cluster...\")\n",
    "\n",
    "try:\n",
    "    # Initialize Ray connection\n",
    "    ray.init(address=RAY_ADDRESS, ignore_reinit_error=True)\n",
    "    \n",
    "    print(\"✅ Connected to Ray cluster successfully!\")\n",
    "    print(f\"   Ray version: {ray.__version__}\")\n",
    "    print(f\"   Cluster resources: {ray.cluster_resources()}\")\n",
    "    print(f\"   Available nodes: {len(ray.nodes())}\")\n",
    "    \n",
    "except Exception as e:\n",
    "    print(f\"❌ Failed to connect to Ray cluster: {str(e)}\")\n",
    "    print(\"💡 Make sure Ray cluster is running and accessible\")\n",
    "    print(\"💡 Check the RAY_ADDRESS environment variable\")\n",
    "    raise"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Load Processed Data from S3"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Define data paths\n",
    "PROCESSED_DATA_PATH = f\"s3://{S3_BUCKET_NAME}/processed-features/\"\n",
    "MODEL_OUTPUT_PATH = f\"s3://{S3_BUCKET_NAME}/models/fraud-detection-xgboost/\"\n",
    "\n",
    "print(f\"📊 Loading processed data from: {PROCESSED_DATA_PATH}\")\n",
    "\n",
    "try:\n",
    "    # Load data using Ray Data\n",
    "    dataset = ray.data.read_parquet(PROCESSED_DATA_PATH)\n",
    "    \n",
    "    print(f\"✅ Data loaded successfully!\")\n",
    "    print(f\"   Dataset size: {dataset.count()} rows\")\n",
    "    print(f\"   Dataset schema: {dataset.schema()}\")\n",
    "    \n",
    "except Exception as e:\n",
    "    print(f\"❌ Error loading data: {str(e)}\")\n",
    "    print(\"💡 Make sure the feature engineering notebook has been run\")\n",
    "    print(\"💡 Check S3 permissions and bucket configuration\")\n",
    "    raise"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Data Preprocessing for Training"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def preprocess_for_training(batch):\n",
    "    \"\"\"Preprocess batch for XGBoost training\"\"\"\n",
    "    import pandas as pd\n",
    "    \n",
    "    # Convert to pandas DataFrame\n",
    "    df = pd.DataFrame(batch)\n",
    "    \n",
    "    # Define feature columns (exclude target and non-feature columns)\n",
    "    exclude_cols = {\n",
    "        'TX_FRAUD',  # target variable\n",
    "        'TX_DATETIME',  # datetime column\n",
    "        'CUSTOMER_ID',  # ID column\n",
    "        'TERMINAL_ID',  # ID column\n",
    "    }\n",
    "    \n",
    "    feature_cols = [col for col in df.columns if col not in exclude_cols]\n",
    "    \n",
    "    # Prepare features and target\n",
    "    X = df[feature_cols].fillna(0)  # Fill NaN values\n",
    "    y = df['TX_FRAUD'] if 'TX_FRAUD' in df.columns else None\n",
    "    \n",
    "    result = {'features': X.values}\n",
    "    if y is not None:\n",
    "        result['target'] = y.values\n",
    "    \n",
    "    return result\n",
    "\n",
    "# Apply preprocessing\n",
    "print(\"⚙️ Preprocessing data for training...\")\n",
    "processed_dataset = dataset.map_batches(preprocess_for_training, batch_format=\"pandas\")\n",
    "\n",
    "# Split into train and test sets\n",
    "print(\"🔀 Splitting data into train/test sets...\")\n",
    "train_dataset, test_dataset = processed_dataset.train_test_split(test_size=0.2, shuffle=True)\n",
    "\n",
    "print(f\"✅ Data preprocessing completed!\")\n",
    "print(f\"   Training set: {train_dataset.count()} samples\")\n",
    "print(f\"   Test set: {test_dataset.count()} samples\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Configure XGBoost Training"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# XGBoost hyperparameters\n",
    "xgb_params = {\n",
    "    \"objective\": \"binary:logistic\",\n",
    "    \"eval_metric\": [\"logloss\", \"auc\"],\n",
    "    \"tree_method\": \"gpu_hist\",  # Use GPU acceleration if available\n",
    "    \"max_depth\": 6,\n",
    "    \"learning_rate\": 0.1,\n",
    "    \"subsample\": 0.8,\n",
    "    \"colsample_bytree\": 0.8,\n",
    "    \"min_child_weight\": 1,\n",
    "    \"gamma\": 0,\n",
    "    \"reg_alpha\": 0,\n",
    "    \"reg_lambda\": 1,\n",
    "    \"random_state\": 42\n",
    "}\n",
    "\n",
    "# Training configuration\n",
    "scaling_config = ScalingConfig(\n",
    "    num_workers=4,  # Number of distributed workers\n",
    "    use_gpu=True,   # Use GPU if available\n",
    "    resources_per_worker={\"CPU\": 2, \"GPU\": 0.5}  # Resources per worker\n",
    ")\n",
    "\n",
    "run_config = RunConfig(\n",
    "    name=\"fraud-detection-xgboost\",\n",
    "    storage_path=\"/tmp/ray_results\",  # Local storage for checkpoints\n",
    "    checkpoint_config=ray.train.CheckpointConfig(\n",
    "        num_to_keep=2,\n",
    "        checkpoint_score_attribute=\"eval-auc\",\n",
    "        checkpoint_score_order=\"max\"\n",
    "    )\n",
    ")\n",
    "\n",
    "print(\"🎯 XGBoost Training Configuration:\")\n",
    "print(f\"   Parameters: {json.dumps(xgb_params, indent=2)}\")\n",
    "print(f\"   Workers: {scaling_config.num_workers}\")\n",
    "print(f\"   GPU enabled: {scaling_config.use_gpu}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Train XGBoost Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create XGBoost trainer\n",
    "trainer = XGBoostTrainer(\n",
    "    scaling_config=scaling_config,\n",
    "    run_config=run_config,\n",
    "    datasets={\"train\": train_dataset, \"valid\": test_dataset},\n",
    "    params=xgb_params,\n",
    "    num_boost_round=100,\n",
    "    dataset_config={\n",
    "        \"train\": ray.train.xgboost.RayDMatrix(\n",
    "            data=\"features\",\n",
    "            label=\"target\"\n",
    "        ),\n",
    "        \"valid\": ray.train.xgboost.RayDMatrix(\n",
    "            data=\"features\",\n",
    "            label=\"target\"\n",
    "        )\n",
    "    }\n",
    ")\n",
    "\n",
    "print(\"🚀 Starting XGBoost training...\")\n",
    "start_time = datetime.now()\n",
    "\n",
    "try:\n",
    "    # Train the model\n",
    "    result = trainer.fit()\n",
    "    \n",
    "    end_time = datetime.now()\n",
    "    training_duration = end_time - start_time\n",
    "    \n",
    "    print(f\"✅ Training completed successfully!\")\n",
    "    print(f\"   Training duration: {training_duration}\")\n",
    "    print(f\"   Best checkpoint: {result.checkpoint}\")\n",
    "    print(f\"   Final metrics: {result.metrics}\")\n",
    "    \n",
    "except Exception as e:\n",
    "    print(f\"❌ Training failed: {str(e)}\")\n",
    "    raise"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Model Evaluation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load the trained model from checkpoint\n",
    "print(\"📊 Evaluating trained model...\")\n",
    "\n",
    "# Get the trained model\n",
    "checkpoint = result.checkpoint\n",
    "with checkpoint.as_directory() as checkpoint_dir:\n",
    "    # Load the XGBoost model\n",
    "    model_path = os.path.join(checkpoint_dir, \"model.xgb\")\n",
    "    trained_model = xgb.Booster()\n",
    "    trained_model.load_model(model_path)\n",
    "\n",
    "print(\"✅ Model loaded for evaluation\")\n",
    "\n",
    "# Evaluate on test set\n",
    "def evaluate_model(batch):\n",
    "    \"\"\"Evaluate model on batch\"\"\"\n",
    "    import xgboost as xgb\n",
    "    import numpy as np\n",
    "    \n",
    "    # Prepare data\n",
    "    X = batch[\"features\"]\n",
    "    y_true = batch[\"target\"]\n",
    "    \n",
    "    # Make predictions\n",
    "    dtest = xgb.DMatrix(X)\n",
    "    y_pred_proba = trained_model.predict(dtest)\n",
    "    y_pred = (y_pred_proba > 0.5).astype(int)\n",
    "    \n",
    "    return {\n",
    "        \"y_true\": y_true,\n",
    "        \"y_pred\": y_pred,\n",
    "        \"y_pred_proba\": y_pred_proba\n",
    "    }\n",
    "\n",
    "# Apply evaluation\n",
    "predictions = test_dataset.map_batches(evaluate_model, batch_format=\"pandas\")\n",
    "pred_results = predictions.to_pandas()\n",
    "\n",
    "# Calculate metrics\n",
    "y_true = np.concatenate(pred_results[\"y_true\"].values)\n",
    "y_pred = np.concatenate(pred_results[\"y_pred\"].values)\n",
    "y_pred_proba = np.concatenate(pred_results[\"y_pred_proba\"].values)\n",
    "\n",
    "# Print evaluation results\n",
    "print(\"\\n📈 Model Evaluation Results:\")\n",
    "print(f\"   AUC Score: {roc_auc_score(y_true, y_pred_proba):.4f}\")\n",
    "print(\"\\n📋 Classification Report:\")\n",
    "print(classification_report(y_true, y_pred, target_names=[\"Legitimate\", \"Fraudulent\"]))\n",
    "print(\"\\n🔍 Confusion Matrix:\")\n",
    "print(confusion_matrix(y_true, y_pred))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Save Model to S3"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(f\"💾 Saving model to S3: {MODEL_OUTPUT_PATH}\")\n",
    "\n",
    "try:\n",
    "    # Create S3 client\n",
    "    s3_client = boto3.client('s3')\n",
    "    \n",
    "    # Save model files locally first\n",
    "    local_model_dir = \"/tmp/fraud_detection_model\"\n",
    "    os.makedirs(local_model_dir, exist_ok=True)\n",
    "    \n",
    "    # Save XGBoost model\n",
    "    model_file = os.path.join(local_model_dir, \"model.xgb\")\n",
    "    trained_model.save_model(model_file)\n",
    "    \n",
    "    # Save model metadata\n",
    "    metadata = {\n",
    "        \"model_type\": \"xgboost\",\n",
    "        \"training_date\": datetime.now().isoformat(),\n",
    "        \"parameters\": xgb_params,\n",
    "        \"metrics\": {\n",
    "            \"auc_score\": float(roc_auc_score(y_true, y_pred_proba)),\n",
    "            \"training_samples\": train_dataset.count(),\n",
    "            \"test_samples\": test_dataset.count()\n",
    "        },\n",
    "        \"ray_version\": ray.__version__,\n",
    "        \"xgboost_version\": xgb.__version__\n",
    "    }\n",
    "    \n",
    "    metadata_file = os.path.join(local_model_dir, \"metadata.json\")\n",
    "    with open(metadata_file, 'w') as f:\n",
    "        json.dump(metadata, f, indent=2)\n",
    "    \n",
    "    # Upload to S3\n",
    "    bucket_name = S3_BUCKET_NAME\n",
    "    model_prefix = \"models/fraud-detection-xgboost/\"\n",
    "    \n",
    "    # Upload model file\n",
    "    s3_client.upload_file(\n",
    "        model_file,\n",
    "        bucket_name,\n",
    "        f\"{model_prefix}model.xgb\"\n",
    "    )\n",
    "    \n",
    "    # Upload metadata\n",
    "    s3_client.upload_file(\n",
    "        metadata_file,\n",
    "        bucket_name,\n",
    "        f\"{model_prefix}metadata.json\"\n",
    "    )\n",
    "    \n",
    "    print(\"✅ Model saved successfully to S3!\")\n",
    "    print(f\"   Model location: s3://{bucket_name}/{model_prefix}model.xgb\")\n",
    "    print(f\"   Metadata location: s3://{bucket_name}/{model_prefix}metadata.json\")\n",
    "    \n",
    "except Exception as e:\n",
    "    print(f\"❌ Error saving model: {str(e)}\")\n",
    "    print(\"💡 Check S3 permissions and bucket configuration\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Training Summary"
   ]
  },
  {
