   "source": [
    "# Model inference demonstration\n",
    "from ray_utils import load_model_from_s3\n",
    "\n",
    "# Model path (would be set after training)\n",
    "model_s3_path = s3_paths['models'] + \"fraud_detection_model.json\"\n",
    "print(f\"Model path: {model_s3_path}\")\n",
    "\n",
    "# Check if model exists\n",
    "try:\n",
    "    bucket_name = model_s3_path.replace('s3://', '').split('/')[0]\n",
    "    s3_key = '/'.join(model_s3_path.replace('s3://', '').split('/')[1:])\n",
    "    \n",
    "    s3_client.head_object(Bucket=bucket_name, Key=s3_key)\n",
    "    print(\"✅ Model found in S3\")\n",
    "    \n",
    "    # Load model for inference\n",
    "    # model = load_model_from_s3(model_s3_path)\n",
    "    # print(\"Model loaded successfully\")\n",
    "    \nexcept Exception as e:\n",
    "    print(\"❌ Model not found - would be created after training\")\n",
    "    print(\"For demo purposes, showing inference setup\")\n",
    "\n",
    "# Ray Serve deployment example\n",
    "ray_serve_code = \"\"\"\n",
    "# Ray Serve deployment for fraud detection\n",
    "from ray import serve\n",
    "import xgboost as xgb\n",
    "import pandas as pd\n",
    "\n",
    "@serve.deployment(num_replicas=2, ray_actor_options={\"num_cpus\": 2})\n",
    "class FraudDetectionModel:\n",
    "    def __init__(self):\n",
    "        self.model = load_model_from_s3(\"s3://fraud-detection-models/fraud_detection_model.json\")\n",
    "    \n",
    "    async def __call__(self, request):\n",
    "        # Preprocess request data\n",
    "        features = self.preprocess_data(request)\n",
    "        \n",
    "        # Make prediction\n",
    "        prediction = self.model.predict(features)\n",
    "        \n",
    "        return {\n",
    "            \"fraud_probability\": float(prediction[0]),\n",
    "            \"fraud_prediction\": bool(prediction[0] > 0.5)\n",
    "        }\n",
    "\n",
    "# Deploy the model\n",
    "app = FraudDetectionModel.bind()\n",
    "\"\"\"\n",
    "\n",
    "print(\"Ray Serve deployment code:\")\n",
    "print(ray_serve_code)"
