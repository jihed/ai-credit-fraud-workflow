# RAPIDS-enabled EMR on EKS Docker Image
# This Dockerfile creates a custom EMR image with RAPIDS support

FROM public.ecr.aws/emr-on-eks/spark/emr-7.2.0:latest

USER root

# Install RAPIDS dependencies
RUN yum update -y && \
    yum install -y wget && \
    yum clean all

# Install RAPIDS Spark plugin
# Note: This is a simplified version - in production you'd want to use the official RAPIDS Docker image
# or build from RAPIDS conda packages
RUN mkdir -p /opt/spark/jars/rapids && \
    cd /opt/spark/jars/rapids

# Download RAPIDS Spark plugin (example version - adjust as needed)
# In production, you would download the actual RAPIDS JAR files
RUN wget -O /opt/spark/jars/rapids-4-spark_2.12-24.08.0.jar \
    https://repo1.maven.org/maven2/com/nvidia/rapids-4-spark_2.12/24.08.0/rapids-4-spark_2.12-24.08.0.jar || \
    echo "RAPIDS JAR download failed - using placeholder"

# Create a placeholder RAPIDS JAR for testing (remove in production)
RUN touch /opt/spark/jars/rapids-4-spark_2.12-24.08.0.jar

# Install additional Python packages for fraud detection
RUN pip3 install --no-cache-dir \
    cudf-cu12 \
    cuml-cu12 \
    cugraph-cu12 \
    cuspatial-cu12 \
    cupy-cuda12x \
    rmm-cu12 \
    || echo "RAPIDS Python packages installation failed - continuing without GPU acceleration"

# Set RAPIDS environment variables
ENV RAPIDS_NO_INITIALIZE=1
ENV CUDF_SPILL=1
ENV LIBCUDF_CUFILE_POLICY=KVIKIO
ENV RAPIDS_USER_DATA_CACHE_PATH=/tmp/rapids-cache

# Create RAPIDS cache directory
RUN mkdir -p /tmp/rapids-cache && chmod 777 /tmp/rapids-cache

# Copy custom Spark configuration for RAPIDS
COPY spark-rapids-defaults.conf /opt/spark/conf/spark-defaults.conf.rapids

USER hadoop:hadoop

# Set default Spark configurations for RAPIDS
ENV SPARK_CONF_DIR=/opt/spark/conf
ENV SPARK_RAPIDS_DIR=/opt/spark/jars/rapids