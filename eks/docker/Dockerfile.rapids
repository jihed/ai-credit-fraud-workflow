# Custom EMR RAPIDS Image for Fraud Detection
# This Dockerfile extends the official EMR RAPIDS image with fraud detection specific packages
# Note: RAPIDS requires NVIDIA GPUs and is primarily available for linux/amd64

# Build arguments for flexibility
ARG TARGETPLATFORM=linux/amd64
ARG EMR_RAPIDS_VERSION=emr-6.9.0-spark-rapids-latest

# Use the official EMR RAPIDS image as base with explicit platform
FROM --platform=${TARGETPLATFORM} public.ecr.aws/emr-on-eks/spark-rapids:${EMR_RAPIDS_VERSION}

USER root

# Validate architecture and GPU requirements
RUN echo "Building for architecture: $(uname -m)" && \
    if [ "$(uname -m)" != "x86_64" ]; then \
        echo "WARNING: RAPIDS is optimized for x86_64 architecture with NVIDIA GPUs"; \
    fi

# Install additional Python packages for fraud detection
# Pin versions for reproducibility across environments
RUN pip3 install --no-cache-dir \
    pandas==2.2.* \
    numpy==1.26.* \
    scikit-learn==1.5.* \
    pyarrow==17.0.* \
    matplotlib==3.9.* \
    seaborn==0.13.* \
    boto3==1.35.* \
    s3fs==2024.* \
    || echo "Additional packages installation completed with some warnings"

# Copy custom fraud detection scripts (optional)
# COPY src/ /opt/fraud-detection/

# Set fraud detection specific environment variables
ENV FRAUD_DETECTION_VERSION=1.0
ENV RAPIDS_USER_DATA_CACHE_PATH=/tmp/rapids-cache

# Ensure cache directory exists with proper permissions
RUN mkdir -p /tmp/rapids-cache && chmod 777 /tmp/rapids-cache

# Add labels for better image management
LABEL maintainer="fraud-detection-team"
LABEL version="1.0"
LABEL description="EMR RAPIDS image for fraud detection with cross-platform considerations"
LABEL platform="${TARGETPLATFORM}"

USER hadoop:hadoop

# Add a simple health check to validate RAPIDS installation
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python3 -c "import cudf, cuml; print('RAPIDS libraries loaded successfully')" || exit 1

# The official EMR RAPIDS image already includes:
# - RAPIDS libraries (cuDF, cuML, cuGraph)
# - RAPIDS Spark plugin
# - Proper GPU configurations
# - CUDA runtime and drivers
# - Optimized Spark settings for GPU acceleration